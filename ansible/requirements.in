# Direct dependencies of the deploy controller (scripts/setup-controller.sh).
# ansible/requirements.txt is generated from this file with every transitive
# dependency pinned and hashed; regenerate it after editing here, from a clean venv:
#
#   python3 -m venv /tmp/uv && /tmp/uv/bin/pip install uv
#   /tmp/uv/bin/uv pip compile ansible/requirements.in --universal --generate-hashes --python-version 3.11 -o ansible/requirements.txt
