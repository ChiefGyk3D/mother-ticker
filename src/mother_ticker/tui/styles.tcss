/* Mother Ticker TUI stylesheet.
   One explicit palette so the console, an SSH session and a screenshot agree.
   On the 16-colour Linux console each value snaps to the nearest ANSI colour.

   background  #0b0e14   panel border  #2f3a4a   dim text  #8b95a5
   accent      #4fd1e3   title bar     #1e3a5f   ok        #22c55e
   warning     #f5a623   critical      #e5383b   critical text #ff6b6b */

Screen {
    layout: vertical;
    background: #0b0e14;
    color: #e6edf3;
}

#banner {
    height: 3;
    content-align: center middle;
    text-style: bold;
    background: #22c55e;
    color: #04160c;
}
#banner.warning {
    background: #f5a623;
    color: #1a1000;
}
#banner.critical {
    background: #e5383b;
    color: #ffffff;
}
#banner.critical.flash {
    background: #ffffff;
    color: #e5383b;
}
#banner.warning.flash {
    background: #1a1000;
    color: #f5a623;
}

#clock {
    width: 100%;
    height: 5;
    content-align: center middle;
    text-align: center;
    margin-top: 1;
    color: #4fd1e3;
}
#clock-sub {
    width: 100%;
    text-align: center;
    color: #8b95a5;
}

#panels {
    height: 1fr;
    margin: 1 2 0 2;
    grid-size: 2;
    grid-gutter: 0 2;
}
.panel {
    height: 1fr;
    border: solid #2f3a4a;
    padding: 0 0 0 1;
}
.panel-icon {
    width: 17;
    height: 1fr;
    content-align: left middle;
    color: #4fd1e3;
}
.panel-text {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
    padding-left: 1;
}
.panel.warning {
    border: solid #f5a623;
}
.panel.warning .panel-icon {
    color: #f5a623;
}
.panel.critical {
    border: solid #e5383b;
    color: #ff6b6b;
    text-style: bold;
}
.panel.critical .panel-icon {
    color: #ff6b6b;
}

#dash-footer {
    dock: bottom;
    height: 1;
    color: #8b95a5;
    padding: 0 1;
}
#footer-left {
    width: 1fr;
}
#footer-right {
    width: auto;
    text-align: right;
}

.title {
    height: 1;
    text-style: bold;
    padding: 0 1;
    background: #1e3a5f;
    color: #e6f1ff;
}
.hint {
    dock: bottom;
    height: 1;
    color: #8b95a5;
    padding: 0 1;
}
.pre {
    padding: 0 1;
}
.status-line {
    padding: 0 1;
    height: auto;
}

OptionList {
    margin: 1 2;
    height: auto;
    max-height: 100%;
    background: #0b0e14;
    border: solid #2f3a4a;
}
OptionList:focus {
    border: solid #4fd1e3;
}
OptionList > .option-list--option-highlighted {
    background: #1e3a5f;
    color: #e6f1ff;
    text-style: bold;
}
#menu-body {
    height: 1fr;
    align: center middle;
    padding: 0 2;
}
#menu-logo {
    width: 50;
    height: 17;
    color: #4fd1e3;
}
#menu-column {
    width: 1fr;
    height: auto;
}
#menu-heading {
    padding: 0 2;
    text-style: bold;
    color: #4fd1e3;
}
#menu {
    margin: 0 2;
}

DataTable {
    margin: 0 1;
    height: 1fr;
    background: #0b0e14;
}
DataTable > .datatable--header {
    background: #1e3a5f;
    color: #e6f1ff;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: #2f3a4a;
    color: #e6edf3;
}
Log {
    margin: 0 1;
    height: 1fr;
    background: #0b0e14;
}

#about-title {
    width: 100%;
    height: 4;
    text-align: center;
    margin-top: 1;
    color: #4fd1e3;
    text-style: bold;
}
#about-tagline {
    width: 100%;
    text-align: center;
    color: #8b95a5;
}
#about-body {
    height: 1fr;
    padding: 1 2;
}
#about-logo {
    width: 50;
    height: 17;
    color: #4fd1e3;
}
#about-text {
    width: 1fr;
    padding: 1 0 0 2;
}

ConfirmScreen {
    align: center middle;
}
#confirm-box {
    width: 60;
    height: auto;
    border: thick #e5383b;
    background: #0b0e14;
    padding: 1 2;
}
#confirm-box Label {
    width: 100%;
    margin-bottom: 1;
}
#confirm-buttons {
    height: 3;
    align: center middle;
}
#confirm-buttons Button {
    margin: 0 2;
}
